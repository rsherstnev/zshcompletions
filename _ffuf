#compdef ffuf

local -a args multiwordlist_modes output_formats http_methods http_codes

args=(
    '*-H[Header "Name: Value", separated by colon (multiple -H flags are accepted)]:headers:()'
    '-X[HTTP method to use]:HTTP method:_values http_method $http_methods'
    '-b[Cookie data "name1=value1; name2=value2" for copy as curl functionality]:cookies:()'
    '-cc[Client cert for authentication. Client key needs to be defined as well for this to work]:client certificate:_files'
    '-ck[Client key for authentication. Client certificate needs to be defined as well for this to work]:client key:_files'
    '-d[POST data]:POST data:()'
    '-http2[Use HTTP2 protocol (default: false)]'
    '-ignore-body[Do not fetch the response content (default: false)]'
    '-r[Follow redirects (default: false)]'
    '-raw[Do not encode URI (default: false)]'
    '-recursion[Scan recursively. Only FUZZ keyword is supported, and URL (-u) has to end in it (default: false)]'
    '-recursion-depth[Maximum recursion depth (default: 0)]:recursion depth:()'
    '-recursion-strategy[Recursion strategy: "default" for a redirect based, and "greedy" to recurse on all matches (default: default)]:recursion strategy:_values recursion_strategy $recursion_strategies'
    '-replay-proxy[Replay matched requests using this proxy]:proxy:()'
    '-sni[Target TLS SNI (does not support FUZZ keyword)]:TLS SNI:()'
    '-timeout[HTTP request timeout in seconds (default: 10)]:timeout:()'
    '-u[Target URL]:URL:()'
    '-x[Proxy URL (e.g. http://127.0.0.1:8080 or socks5://127.0.0.1:8080)]:HTTP or SOCKS proxy URL:()'
    '-V[Show version information (default: false)]'
    '-ac[Automatically calibrate filtering options (default: false)]'
    '*-acc[Custom auto-calibration string (can be used multiple times, implies -ac)]:calibration string:()'
    '-ach[Per host autocalibration (default: false)]'
    '-ack[Autocalibration keyword (default: FUZZ)]:keyword:()'
    '*-acs[Custom auto-calibration strategies (can be used multiple times, implies -ac)]:calibration strategies:()'
    '-c[Colorize output (default: false)]'
    '-config[Load configuration from a file]:configuration:_files'
    '-json[JSON output, printing newline-delimited JSON records (default: false)]'
    '-maxtime[Maximum running time in seconds for entire process. (default: 0)]:time for entire process:()'
    '-maxtime-job[Maximum running time in seconds per job (default: 0)]:time per job:()'
    '-noninteractive[Disable the interactive console functionality (default: false)]'
    '-p[Seconds of delay between requests, or a range for random delay (e.g. 0.1 or 0.1-2.0)]:delay:()'
    '-rate[Rate of requests per second (default: 0)]:rate:()'
    '-s[Do not print additional information (silent mode)]'
    '-sa[Stop on all error cases. Implies -sf and -se (default: false)]'
    '-scraperfile[Custom scraper file path]:scraper file:_files'
    '-scrapers[Active scraper groups (default: all)]:scraper group:()'
    '-se[Stop on spurious errors (default: false)]'
    '-search[Search for a FFUFHASH payload from ffuf history]'
    '-sf[Stop when > 95% of responses return 403 Forbidden (default: false)]'
    '-t[Number of concurrent threads (default: 40)]:threads:()'
    '-v[Verbose output, printing full URL and redirect location (if any) with the results (default: false)]'
    '-mc[Match HTTP status codes, or "all" for everything (default: 200-299,301,302,307,401,403,405,500)]:HTTP status codes:_values -s ',' http_codes $http_codes'
    '-ml[Match amount of lines in response]:lines:()'
    '-mmode[Matcher set operator: "and" or "or" (default: or)]:mmode:_values mmode $mmodes'
    '-mr[Match regexp]:regexp:()'
    '-ms[Match HTTP response size]:size:()'
    '-mt[Match how many milliseconds to the first response byte, either greater or less than (e.g. ">100 or <100")]:milliseconds:()'
    '-mw[Match amount of words in response]:words:()'
    '-fc[Filter HTTP status codes from response. Comma separated list of codes and ranges]:codes:_values -s ',' http_codes $http_codes'
    '-fl[Filter by amount of lines in response. Comma separated list of line counts and ranges]:lines:()'
    '-fmode[Filter set operator: "and" or "or" (default: or)]:mmode:_values mmode $mmodes'
    '-fr[Filter regexp]:regexp:()'
    '-fs[Filter HTTP response size. Comma separated list of sizes and ranges]:size:()'
    '-ft[Filter by number of milliseconds to the first response byte, either greater or less than (e.g. ">100 or <100")]:milliseconds:()'
    '-fw[Filter by amount of words in response. Comma separated list of word counts and ranges]:words:()'
    '-D[DirSearch wordlist compatibility mode. Used in conjunction with -e flag (default: false)]'
    '-e[Comma separated list of extensions. Extends FUZZ keyword]:extensions:()'
    '-enc[Encoders for keywords, e.g. "FUZZ:urlencode b64encode"]:encoders:()'
    '-ic[Ignore wordlist comments (default: false)]'
    '-input-cmd[Command producing the input. --input-num is required when using this input method. Overrides -w]:command:()'
    '-input-num[Number of inputs to test. Used in conjunction with --input-cmd (default: 100)]:number of inputs:()'
    '-input-shell[Shell to be used for running command]:shell:()'
    '-mode[Multi-wordlist operation mode: clusterbomb, pitchfork, sniper (default: clusterbomb)]:operation mode:_values mode $multiwordlist_modes'
    '-request[File containing the raw http request]:request file:_files'
    '-request-proto[Protocol to use along with raw request (default: https)]:request protocol:()'
    '*-w[Wordlist and (optional) keyword in format wordlist\[:keyword\]]:wordlist:_files'
    '-debug-log[Write all of the internal logging to the specified file]:logfile:_files -X "Select output file or enter filename manually"'
    '-o[Write output to file]:output file:_files -X "Select output file or enter filename manually"'
    '-od[Directory path to store matched results to]:results dir:_files -/'
    '-of[Output file format. Available formats: json, ejson, html, md, csv, ecsv (or, "all" for all formats) (default: json)]:output format:_values format $output_formats'
    "-or[Don't create the output file if we don't have results (default: false)]"
)

multiwordlist_modes=('pitchfork' 'clusterbomb' 'sniper')
mmodes=('and', 'or')
output_formats=('json' 'ejson' 'html' 'md' 'csv' 'ecsv', 'all')
http_methods=('OPTIONS' 'GET' 'HEAD' 'POST' 'PUT' 'PATCH' 'DELETE' 'TRACE' 'CONNECT')
recursion_strategies=('default','greedy')

http_codes=(
